# Copy to .env and fill in your own keys. Never commit .env.
NVIDIA_API=            # NVIDIA NIM key (chat + embeddings) - https://build.nvidia.com
TAVILY_API_KEY=        # Tavily web search - https://tavily.com

# Optional: LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-rag
